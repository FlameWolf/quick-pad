{
	"name": "quick-pad",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node ./scripts/run-all dev",
		"build": "npm run type-check && npm run build-only",
		"preview": "node ./scripts/run-all preview",
		"build-only": "vite build",
		"type-check": "vue-tsc --build",
		"format": "prettier --write --experimental-cli src/"
	},
	"dependencies": {
		"bootstrap": "^5.3.9",
		"idb": "^8.0.4",
		"jszip": "^3.10.2",
		"vue": "^3.5.46",
		"vue-router": "^5.5.1"
	},
	"devDependencies": {
		"@fullhuman/postcss-purgecss": "^9.1.0",
		"@types/babel__core": "^7.20.5",
		"@types/node": "^26.6.11",
		"@vitejs/plugin-vue": "^6.0.11",
		"@vue/tsconfig": "^0.9.1",
		"prettier": "3.10.1",
		"typescript": "~6.0.3",
		"vite": "^8.3.8",
		"vue-tsc": "^3.3.14"
	}
}